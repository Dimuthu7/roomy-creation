# Copy this file to .env.local and fill in real values. Next.js loads .env.local
# automatically; never commit real secrets to .env.example.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Mailbox that receives quotation requests
ENQUIRY_TO_EMAIL=

# Verified sender address quotation requests are sent from (must be a domain
# verified in Resend)
ENQUIRY_FROM_EMAIL=

# Verified sender address quotation, invoice and warranty documents are sent from
# (must be a domain verified in Resend). Kept separate from ENQUIRY_FROM_EMAIL so
# customer documents and inbound enquiries can use different addresses.
DOCS_FROM_EMAIL=

# Neon Postgres connection string — https://neon.tech
DATABASE_URL=

# Public address of the Cloudflare R2 bucket that stores uploads and generated
# documents (bound as UPLOADS in wrangler.jsonc), no trailing slash. Find it under
# R2 -> roomy-creations-uploads -> Settings -> Public Development URL, e.g.
# https://pub-0123456789abcdef.r2.dev — or a custom domain connected to the bucket.
# Writes go through the Worker binding, so no R2 API key is needed. For `next dev`,
# run `npx wrangler login` once so the dev server can reach the real bucket.
R2_PUBLIC_URL=

# Admin portal login — pick your own values, not a real account anywhere else
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Facebook Page reviews sync (admin portal's "Sync from Facebook" button). Setup:
#   1. Create an app at developers.facebook.com (Business type).
#   2. Add yourself as an admin of the Facebook Page these reviews come from.
#   3. In Graph API Explorer, select the app and generate a User Access Token
#      with the pages_show_list and pages_read_user_content permissions.
#   4. Make that user token long-lived FIRST (Access Token Debugger -> Extend
#      Access Token), so the sync button doesn't break after ~1 hour.
#   5. Then call me/accounts with the long-lived user token. Use this Page's
#      "id" as FACEBOOK_PAGE_ID and its "access_token" as
#      FACEBOOK_PAGE_ACCESS_TOKEN — a Page token derived from a long-lived user
#      token doesn't expire.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
