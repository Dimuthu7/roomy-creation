# Copy this file to .env.local and fill in real values. Next.js loads .env.local
# automatically; never commit real secrets to .env.example.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Mailbox that receives quotation requests
ENQUIRY_TO_EMAIL=

# Verified sender address quotation requests are sent from (must be a domain
# verified in Resend)
ENQUIRY_FROM_EMAIL=

# Neon Postgres connection string — https://neon.tech
DATABASE_URL=

# Vercel Blob read/write token — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=

# Admin portal login — pick your own values, not a real account anywhere else
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Facebook Page reviews sync (admin portal's "Sync from Facebook" button). Setup:
#   1. Create an app at developers.facebook.com (Business type).
#   2. Add yourself as an admin of the Facebook Page these reviews come from.
#   3. In Graph API Explorer, select the app, generate a User Access Token with
#      the pages_show_list and pages_read_user_content permissions, then use the
#      "Get Page Access Token" step for this Page.
#   4. Exchange it for a long-lived token (Access Token Debugger -> Extend Access
#      Token), so the sync button doesn't break after ~1 hour.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
